            "segment",
            "region",
            "payment_terms_days",
            "credit_limit",
            "acquisition_month"
          ]
        },
        "channel_master": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "channel"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "channel_id",
            "channel_type",
            "platform_fee_pct",
            "commission_pct",
            "settlement_days",
            "default_discount_pct"
          ]
        },
        "commercial_costs": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "month_sku_channel"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
