            "forecast_version"
          ]
        },
        "promotions": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "promotion"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "promo_id",
            "start_date",
            "end_date",
            "channel_id",
            "sku_id",
            "mechanic",
            "planned_discount_pct",
