            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "snapshot_month",
            "target_month",
            "sku_id",
            "channel_id",
            "forecast_units",
            "forecast_net_sales",
