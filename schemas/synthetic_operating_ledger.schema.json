        "marketing_spend": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "month_channel_campaign"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "month",
            "channel_id",
            "campaign_id",
            "spend",
            "impressions",
            "clicks",
            "orders",
            "attributed_net_sales",
            "cac",
            "roas"
          ]
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "synthetic_notice",
        "source_policy",
        "reproducibility"
      ],
      "properties": {
        "synthetic_notice": {
          "const": "No row is sourced from a real customer, supplier, employee, or transaction."
        },
        "source_policy": {
          "type": "string",
          "const": "Synthetic operating data is generated from explicit assumptions; public-company reports remain in the peer panel and are never mixed into the synthetic ledger."
        },
        "reproducibility": {
          "type": "string",
          "const": "Fixed seed, explicit event calendar, versioned parameter dictionary, and deterministic QA manifest."
        }
      }
    }
  }
}