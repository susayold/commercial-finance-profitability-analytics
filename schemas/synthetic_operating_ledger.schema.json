          ]
        },
        "budget": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "month_sku_channel"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "version",
