{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VietNova synthetic operating ledger",
  "type": "object",
  "required": [
    "dataset_version",
    "as_of_date",
    "tables",
    "lineage"
  ],
  "properties": {
    "dataset_version": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "seed": {
      "type": "integer"
    },
    "tables": {
      "type": "object",
      "required": [
        "sales_fact",
        "product_master",
        "customer_master",
        "channel_master",
        "commercial_costs",
        "inventory",
        "receivables",
        "payables",
        "debt",
        "budget",
        "forecast",
        "promotions",
        "marketing_spend"
      ],
      "properties": {
        "sales_fact": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "order_line_day_sku_channel_customer_region"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "date",
            "month",
            "order_id",
            "line_id",
            "sku_id",
            "customer_id",
            "channel_id",
            "region",
            "units",
            "gross_sales",
            "discount",
            "returns",
            "net_sales",
            "cogs",
            "freight",
            "payment_fee",
            "commission",
            "trade_spend",
            "contribution_margin",
            "promo_id",
            "is_stockout",
            "is_intercompany"
          ]
        },
        "product_master": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "sku"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "sku_id",
            "category",
            "brand",
            "pack_size",
            "list_price",
            "standard_cogs",
            "supplier_id",
            "launch_month",
            "status"
          ]
        },
        "customer_master": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "customer"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
