            "overdue_61_plus",
            "dso"
          ]
        },
        "payables": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
              "const": "month_supplier"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x_expected_columns": [
            "month",
            "supplier_id",
            "opening_ap",
            "purchases",
            "cash_paid",
            "closing_ap",
            "overdue_ap",
            "dpo"
          ]
        },
        "debt": {
          "type": "object",
          "required": [
            "grain",
            "columns"
          ],
          "properties": {
            "grain": {
