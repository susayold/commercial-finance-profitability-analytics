{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/susayold/commercial-finance-profitability-analytics/schemas/forecast_snapshot_live.schema.json",
  "title": "Leakage-safe live forecast snapshot row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forecast_version",
    "forecast_created_date",
    "target_month",
    "company",
    "brand",
    "channel",
    "forecast_revenue_vnd",
    "actual_revenue_vnd",
    "actual_available_date",
    "as_of_date",
    "eligibility_status",
    "error_vnd",
    "abs_error_vnd",
    "snapshot_status",
    "source_model_version",
    "approver",
    "actual_period_close_date",
    "exception_note",
    "evidence_class",
    "source_evidence_uri"
  ],
  "properties": {
    "forecast_version": {"type": "string", "minLength": 1},
    "forecast_created_date": {"type": "string", "format": "date-time"},
    "target_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "company": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "forecast_revenue_vnd": {"type": "number", "minimum": 0},
    "actual_revenue_vnd": {"type": "number", "minimum": 0},
    "actual_available_date": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": "string", "format": "date"},
    "eligibility_status": {"enum": ["ELIGIBLE", "NOT_ELIGIBLE", "FUTURE_LEAKAGE", "INVALID_INPUT"]},
    "error_vnd": {"type": "number"},
    "abs_error_vnd": {"type": "number", "minimum": 0},
    "snapshot_status": {"enum": ["DRAFT", "FROZEN", "EXCEPTION"]},
    "source_model_version": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "actual_period_close_date": {"type": "string", "format": "date"},
    "exception_note": {"type": "string"},
    "evidence_class": {"enum": ["LIVE_INTERNAL", "SIMULATED", "DEMO_FIXTURE_ONLY"]},
    "source_evidence_uri": {"type": "string", "minLength": 1}
  }
}
