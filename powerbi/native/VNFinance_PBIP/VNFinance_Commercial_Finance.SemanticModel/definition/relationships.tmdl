	fromColumn: Sales.sku_id
	toColumn: Product.sku_id

relationship rel-sales-customer
	fromColumn: Sales.customer_id
	toColumn: Customer.customer_id

relationship rel-sales-channel
	fromColumn: Sales.channel_id
	toColumn: Channel.channel_id

