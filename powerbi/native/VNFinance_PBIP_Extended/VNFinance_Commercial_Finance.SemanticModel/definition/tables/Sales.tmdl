		lineageTag: d2d14986-97d0-4728-a12d-190109502d1d

	measure 'OPEX vs Budget' = [OPEX Actual] - [OPEX Budget]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: 0854f3dc-ec5b-4551-b824-13283435aa20

	measure 'OPEX vs Forecast' = [OPEX Actual] - [OPEX Forecast]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: 11fdb77f-a37b-4de8-af56-c682cb5deb5b

	measure 'Average Headcount' = SUM ( OPEX_Headcount[avg_headcount] )
		formatString: #,0.0
		lineageTag: 4216bdf0-f9b4-42bf-ae4c-2811eb1e9ff9

	measure 'CAPEX Budget' = SUM ( CAPEX_Projects[budget_capex_vnd] )
		formatString: #,0,,.0 M
		lineageTag: 85465f6a-badd-4468-8c1d-265fcf39168c

	measure 'CAPEX Actual' = SUM ( CAPEX_Projects[actual_capex_vnd] )
		formatString: #,0,,.0 M
		lineageTag: eaaff16d-688e-4c34-815c-9181e166f3e0

	measure 'CAPEX Forecast' = SUM ( CAPEX_Projects[forecast_capex_vnd] )
		formatString: #,0,,.0 M
