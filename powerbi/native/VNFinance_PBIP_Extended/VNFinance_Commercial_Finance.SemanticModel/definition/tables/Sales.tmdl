	measure 'CAPEX Committed' = SUM ( CAPEX_Projects[committed_capex_vnd] )
		formatString: #,0,,.0 M
		lineageTag: 2194dd95-cf2f-4007-abae-299b73176a5d

	measure 'CAPEX Cash Payment' = SUM ( CAPEX_Projects[cash_payment_vnd] )
		formatString: #,0,,.0 M
		lineageTag: 9f2d032f-814a-4452-9019-e76d9bf10e4b

	measure 'CAPEX Depreciation' = SUM ( CAPEX_Projects[depreciation_vnd] )
