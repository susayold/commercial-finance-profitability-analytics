table Sales
	lineageTag: 57b5e053-a4b4-41bc-9ff3-ec50256083c1

	measure 'Net Revenue' = SUM ( Sales[net_sales] )
		formatString: #,0,,.0 M
		lineageTag: 9a5258eb-f1d0-4d6d-9bb1-0a64c431792b

	measure 'Gross Sales' = SUM ( Sales[gross_sales] )
		formatString: #,0,,.0 M
		lineageTag: 2b42f375-4020-432e-83b9-098480a9247d

	measure 'COGS Total' = SUM ( Sales[cogs] )
		formatString: #,0,,.0 M
		lineageTag: e10176c7-7a7f-4019-8b94-e3a34c52f79a

	measure 'Gross Profit' = [Net Revenue] - [COGS Total]
		formatString: #,0,,.0 M
		lineageTag: fd4923ca-713a-425a-82d7-5c8a76320e83

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Net Revenue] )
		formatString: 0.0%
		lineageTag: e6096084-35fd-4e98-86b2-8967a701d540

	measure 'Contribution Margin' = SUM ( Sales[contribution_margin] )
		formatString: #,0,,.0 M
		lineageTag: 08bc9158-6efe-40bf-9a39-200e5aa34427

	measure 'Contribution Margin %' = DIVIDE ( [Contribution Margin], [Net Revenue] )
		formatString: 0.0%
		lineageTag: 652856c7-3a1e-414f-864d-35bcf5d7743c

	measure 'Units Total' = SUM ( Sales[units] )
		formatString: #,0
		lineageTag: ef54aec6-409b-4520-8438-e7b709382576

	measure ASP = DIVIDE ( [Net Revenue], [Units Total] )
		formatString: #,0
		lineageTag: 141e804d-48aa-4268-9534-225fc61c232b

	measure 'Budget Revenue' = SUM ( Budget[budget_net_sales] )
		formatString: #,0,,.0 M
		lineageTag: 316c642e-3be6-4d34-8c78-89c229459e54

	measure 'Forecast Revenue' = SUM ( Forecast[forecast_net_sales] )
		formatString: #,0,,.0 M
		lineageTag: e91f5fb9-e08c-4f92-bf8f-b8dd5ec747df

	measure 'Revenue vs Budget' = [Net Revenue] - [Budget Revenue]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: f42e85ea-b8f6-45e5-ab2f-ac698fbc0104

	measure 'Revenue vs Budget %' = DIVIDE ( [Revenue vs Budget], [Budget Revenue] )
		formatString: 0.0%;(0.0%)
		lineageTag: 18127aa6-b5af-4e99-8cf6-38a1c46ee241

	measure 'Revenue vs Forecast' = [Net Revenue] - [Forecast Revenue]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: 3d80cc63-7d66-4b51-a146-f62897fa3816

	measure 'Revenue vs Forecast %' = DIVIDE ( [Revenue vs Forecast], [Forecast Revenue] )
		formatString: 0.0%;(0.0%)
		lineageTag: a2bbca34-59d1-4c60-9449-ac69491a2d53

	measure 'Prior Net Revenue' = CALCULATE ( [Net Revenue], DATEADD ( Calendar[month], -1, MONTH ) )
		formatString: #,0,,.0 M
		lineageTag: 8f0569c0-de00-4b05-956e-9444224b415d

	measure 'Revenue Growth %' = DIVIDE ( [Net Revenue] - [Prior Net Revenue], [Prior Net Revenue] )
		formatString: 0.0%;(0.0%)
		lineageTag: fbdae33a-42e3-4d87-b99d-d119a84662fb

	measure 'Prior Units' = CALCULATE ( [Units Total], DATEADD ( Calendar[month], -1, MONTH ) )
		formatString: #,0
		lineageTag: afae3ea6-c048-4165-8ab3-4af4a7b3568c

	measure 'Prior ASP' = CALCULATE ( [ASP], DATEADD ( Calendar[month], -1, MONTH ) )
		formatString: #,0
		lineageTag: f2dbd0d3-fb7b-44cd-9bff-8712730f1586

	measure 'Price Impact' = ( [ASP] - [Prior ASP] ) * [Units Total]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: 63ce53c6-7a89-439e-b279-47bf2870d1b4

	measure 'Volume Impact' = ( [Units Total] - [Prior Units] ) * [Prior ASP]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: 8fb2b1b4-f5ba-4fc1-82b0-aca0ec7db2ea

	measure 'Mix Other Impact' = [Net Revenue] - [Prior Net Revenue] - [Price Impact] - [Volume Impact]
		formatString: #,0,,.0 M;(#,0,,.0 M)
		lineageTag: f5a5a584-5bc8-4c8f-a1a8-16ba737bf46b

	measure 'Trade Spend' = SUM ( Commercial_Costs[trade_spend] )
		formatString: #,0,,.0 M
		lineageTag: 75e613c2-9f6a-4fe9-aa04-1d483281dd26

	measure 'Marketing Spend' = SUM ( Marketing[spend] )
		formatString: #,0,,.0 M
		lineageTag: 91fccf30-9093-42db-950f-4156c824900e

	measure 'Ending AR' = CALCULATE ( SUM ( Receivables[closing_ar] ), LASTDATE ( Calendar[month] ) )
		formatString: #,0,,.0 M
		lineageTag: 06475651-4227-4c51-8d50-7b4a6f59ccf1

	measure 'Ending Inventory' = CALCULATE ( SUM ( Inventory[inventory_value] ), LASTDATE ( Calendar[month] ) )
		formatString: #,0,,.0 M
		lineageTag: e9e3be7b-9e4e-4cb9-97f6-b589ebb95bca

	measure 'Ending AP' = CALCULATE ( SUM ( Payables[closing_ap] ), LASTDATE ( Calendar[month] ) )
		formatString: #,0,,.0 M
		lineageTag: f5afbd32-a8b7-4ab7-afc2-da85d4ddffd3

	measure DSO = CALCULATE ( AVERAGE ( Receivables[dso] ), LASTDATE ( Calendar[month] ) )
		formatString: 0.0
		lineageTag: ad3bf101-a6a1-4448-a0e0-5164eb976a64

	measure DIO = CALCULATE ( AVERAGE ( Inventory[days_on_hand] ), LASTDATE ( Calendar[month] ) )
		formatString: 0.0
		lineageTag: 6dcacef1-8890-4183-a00b-d9eccf194f81

	measure DPO = CALCULATE ( AVERAGE ( Payables[dpo] ), LASTDATE ( Calendar[month] ) )
		formatString: 0.0
		lineageTag: c1978753-f2da-4131-b199-ff93dd9d4725

	measure CCC = [DSO] + [DIO] - [DPO]
		formatString: 0.0
		lineageTag: 1a972062-6661-4092-8db2-635360318b0b

	measure 'Debt Balance' = CALCULATE ( SUM ( Debt[closing_balance] ), LASTDATE ( Calendar[month] ) )
		formatString: #,0,,.0 M
		lineageTag: 26333e6e-ffa6-479f-9117-4ba780186803

	measure 'Covenant Headroom' = CALCULATE ( SUM ( Debt[covenant_headroom] ), LASTDATE ( Calendar[month] ) )
		formatString: #,0,,.0 M
		lineageTag: 17cec5b2-36aa-47d9-af38-1d65d26140e6

	measure 'Sales Rows' = COUNTROWS ( Sales )
		formatString: #,0
		lineageTag: 81922f21-7616-4a22-8b57-03cbe8029f8e

	measure 'Product Rows' = COUNTROWS ( Product )
		formatString: #,0
		lineageTag: 9feb9b51-2d06-485f-94d4-b521a3185cc6

	measure 'Customer Rows' = COUNTROWS ( Customer )
		formatString: #,0
		lineageTag: 9a0901f2-e0bb-4a09-9d57-043d8697a9b6

	measure 'Refresh Timestamp' = NOW ()
		formatString: yyyy-mm-dd hh:mm:ss
		lineageTag: 48b58e4a-cf51-4e9d-97a6-fa09a9434a2d

	measure 'Selected Scenario' = SELECTEDVALUE ( 'Scenario Selector'[scenario], "Actual" )
		formatString: @
		lineageTag: 5d053e88-fe26-448c-8185-d3e59e239e00

	measure 'Scenario Revenue' = SWITCH ( [Selected Scenario], "Budget", [Budget Revenue], "Forecast", [Forecast Revenue], [Net Revenue] )
		formatString: #,0,,.0 M
		lineageTag: cd969bef-8c54-4f0d-97a2-50eedbbed01b

	measure 'EBITDA Proxy' = [Gross Profit] - [OPEX Actual]
		formatString: #,0,,.0 M
		lineageTag: 7daeeee3-77d0-4011-bfc7-20ca8bf5bcc0

	measure 'OPEX Actual' = SUM ( OPEX_Headcount[opex_actual_vnd] )
		formatString: #,0,,.0 M
		lineageTag: a228ad2f-5f77-44d4-ad09-9bdc0a29027f

	measure 'OPEX Budget' = SUM ( OPEX_Headcount[opex_budget_vnd] )
