	measure 'CAPEX Annual Benefit' = SUM ( CAPEX_Projects[expected_annual_contribution_vnd] )
		formatString: #,0,,.0 M
		lineageTag: e1a2254f-9a9e-4a3f-8ccd-c5c50bec2206

	measure 'CAPEX Payback Months' = AVERAGE ( CAPEX_Projects[payback_months] )
