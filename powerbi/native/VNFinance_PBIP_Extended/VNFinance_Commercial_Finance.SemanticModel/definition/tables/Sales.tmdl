		lineageTag: fa04c4b6-0c65-4d9b-8f28-9ffab3f3935b

	measure 'Approved Peer Rows' = COUNTROWS ( Peer_Benchmark )
		formatString: #,0
		lineageTag: 48607671-4b55-46f0-b18f-295b8e1b1d39

	measure 'Peer Revenue' = SUM ( Peer_Benchmark[net_revenue_vnd_bn] )
		formatString: #,0.0
		lineageTag: 0570d914-31ba-4f1f-b51f-f3ecb3e857e8

	measure 'Peer PAT Margin' = DIVIDE ( SUM ( Peer_Benchmark[profit_after_tax_vnd_bn] ), SUM ( Peer_Benchmark[net_revenue_vnd_bn] ) )
		formatString: 0.0%
		lineageTag: 65694e9c-a7ea-46a4-b3e0-1bef6b2dbe52

