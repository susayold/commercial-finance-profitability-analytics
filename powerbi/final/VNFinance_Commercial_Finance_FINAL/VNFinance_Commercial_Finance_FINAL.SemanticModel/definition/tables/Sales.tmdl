		displayFolder: 04 Commercial
		lineageTag: 8f174834-0c08-4aa9-b02c-ea624441fbdb

	measure 'Contribution Profit' = [Net Revenue] - [COGS] - [Channel Fees] - [Trade Spend] - [Variable Fulfilment]
