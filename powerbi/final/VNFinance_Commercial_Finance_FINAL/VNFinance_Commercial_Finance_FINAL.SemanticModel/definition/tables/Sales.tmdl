	measure 'Price Effect' = CALCULATE ( SUM ( Fact_PVM_Bridge[AmountVND] ), Fact_PVM_Bridge[Component] = "PRICE" )
		formatString: #,0
		displayFolder: 03 Revenue Bridge
		lineageTag: 282afb52-a535-4982-8ad6-383e6b1cf929

	measure 'Volume Effect' = CALCULATE ( SUM ( Fact_PVM_Bridge[AmountVND] ), Fact_PVM_Bridge[Component] = "VOLUME" )
		formatString: #,0
		displayFolder: 03 Revenue Bridge
		lineageTag: b525ed77-0bd3-48d2-92f9-4cd064981643

	measure 'Mix Effect' = CALCULATE ( SUM ( Fact_PVM_Bridge[AmountVND] ), Fact_PVM_Bridge[Component] = "MIX_RESIDUAL" )
		formatString: #,0
		displayFolder: 03 Revenue Bridge
		lineageTag: 3b066ba2-0f45-41e6-9075-f26f236de6db

	measure 'PVM Residual' = SUMX ( SUMMARIZE ( Fact_PVM_Bridge, Fact_PVM_Bridge[MonthStart], Fact_PVM_Bridge[SKUKey], Fact_PVM_Bridge[ChannelKey], "CurrentValue", MAX ( Fact_PVM_Bridge[CurrentRevenueVND] ), "BaseValue", MAX ( Fact_PVM_Bridge[BaseRevenueVND] ), "BridgeValue", SUM ( Fact_PVM_Bridge[AmountVND] ) ), [CurrentValue] - [BaseValue] - [BridgeValue] )
		formatString: #,0
		displayFolder: 03 Revenue Bridge
		lineageTag: 466e83c6-5f1d-471e-9797-99587af24917

