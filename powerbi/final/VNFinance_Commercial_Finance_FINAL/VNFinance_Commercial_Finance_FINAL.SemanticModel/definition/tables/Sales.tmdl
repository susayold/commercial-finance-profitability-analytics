	measure 'Operating Profit' = [Contribution Profit] - [OPEX Actual]
		formatString: #,0
		displayFolder: 01 Financial
		lineageTag: 823817af-7e57-4eed-83ed-ed723b190fcf

	measure 'Scenario Operating Profit' = [Scenario Revenue] - [Scenario COGS] - [OPEX Actual]
		formatString: #,0
		displayFolder: 06 Forecast
		lineageTag: e451577a-d2f5-44a5-9653-84a6a59e6a7c

	measure 'Scenario CM %' = DIVIDE ( [Scenario Revenue] - [Scenario COGS] - [Trade Spend], [Scenario Revenue] )
		formatString: 0.0%
		displayFolder: 06 Forecast
		lineageTag: 1103d27f-1dda-4f75-9a2b-f02e2dfdf24f

	measure 'Scenario CCC' = VAR s = [Selected Scenario] VAR delta = COALESCE ( CALCULATE ( MAX ( Fact_Forecast[WorkingCapitalDaysDelta] ), Fact_Forecast[ScenarioKey] = SWITCH ( s, "Base", "BASE", "Upside", "UPSIDE", "Downside", "DOWNSIDE", "BASE" ) ), 0 ) RETURN [CCC] + delta
		formatString: 0.0
		displayFolder: 06 Forecast
		lineageTag: 97480455-aaf2-4f17-b41e-7721b0654047

	measure 'Scenario Liquidity Headroom' = [Liquidity Headroom] - MAX ( 0, [Scenario CCC] - 45 ) * DIVIDE ( [Scenario Revenue], 365 )
		formatString: #,0
		displayFolder: 06 Forecast
		lineageTag: 4871febd-a853-43ac-89fa-1c1585eef114

	measure 'Forecast Bias Eligible' = VAR f = CALCULATE ( SUM ( Fact_Forecast[ForecastRevenueVND] ), Fact_Forecast[ScenarioKey] = "BASE", Fact_Forecast[Eligibility] = "true" ) RETURN DIVIDE ( f - [Net Revenue], [Net Revenue] )
		formatString: 0.0%
