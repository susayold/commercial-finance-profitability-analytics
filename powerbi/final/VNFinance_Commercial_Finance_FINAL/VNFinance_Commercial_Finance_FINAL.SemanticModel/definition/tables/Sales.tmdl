		displayFolder: 05 Working Capital
		lineageTag: efe2956d-4f7c-4845-a6ae-4b3bf3fcb4eb

	measure 'COGS Flow' = SUM ( Fact_Inventory[COGSFlowVND] )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: 17084b0c-a39e-4e7f-bfa2-82a4e563fb0f

	measure Purchases = SUM ( Fact_AP[PurchasesVND] )
		formatString: #,0
		lineageTag: 48ccbc54-2c78-4a1e-bebd-dbc64a085b75

	measure 'Days In Selected Period' = SUM ( Dim_Date[DaysInMonth] )
		formatString: 0.0
		displayFolder: 05 Working Capital
		lineageTag: 0ca33dfe-6aea-468b-88c8-d4c833866762

	measure DSO = DIVIDE ( [AR Closing], [Net Credit Sales] ) * [Days In Selected Period]
		formatString: 0.0
		lineageTag: ad804bbf-1079-4ae9-a472-7d73949ae492

	measure DIO = DIVIDE ( [Inventory Closing], [COGS Flow] ) * [Days In Selected Period]
		formatString: 0.0
		lineageTag: 8807d1e6-4896-475e-8739-64ca4e810208

	measure DPO = DIVIDE ( [AP Closing], [Purchases] ) * [Days In Selected Period]
		formatString: 0.0
		lineageTag: 5f2356d6-a8fc-429d-b965-5ec76334a31e

	measure CCC = [DSO] + [DIO] - [DPO]
		formatString: 0.0
		lineageTag: 7d48c2ea-fea3-4224-8c33-5fd990a3c0f1

	measure 'Average AR LTM' = AVERAGEX ( VALUES ( Dim_Date[MonthStart] ), CALCULATE ( [AR Closing] ) )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: 3ffbfde3-05f7-43f3-9b85-2f48915f137b

	measure 'Average Inventory LTM' = AVERAGEX ( VALUES ( Dim_Date[MonthStart] ), CALCULATE ( [Inventory Closing] ) )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: 6f544812-7d94-4dbd-815c-2736b994e299

	measure 'Average AP LTM' = AVERAGEX ( VALUES ( Dim_Date[MonthStart] ), CALCULATE ( [AP Closing] ) )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: fbde1061-533b-4008-8659-e3b8bfc65da0

	measure 'DSO LTM' = DIVIDE ( [Average AR LTM], CALCULATE ( [Net Credit Sales], DATESINPERIOD ( Dim_Date[Date], MAX ( Dim_Date[Date] ), -12, MONTH ) ) ) * 365
		formatString: 0.0
		displayFolder: 05 Working Capital
		lineageTag: 1ae46da9-5aff-4064-9d6f-ada3fe4c5f3b

	measure 'Cash Release Opportunity' = MAX ( 0, [CCC] - 45 ) * DIVIDE ( [Net Revenue], [Days In Selected Period] )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: 82967abf-8943-401e-8744-e9eb85a39146

	measure 'Contribution After WC' = [Contribution Profit] - DIVIDE ( [AR Closing] * 0.08, 365 )
		formatString: #,0
		displayFolder: 05 Working Capital
		lineageTag: 8c474fc3-7291-4ea9-b948-f49ef5982528

	measure 'Debt Balance' = SUM ( Fact_Debt_Liquidity[ClosingBalanceVND] )
