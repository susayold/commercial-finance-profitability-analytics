		lineageTag: f1d2ba7c-d5ff-4683-843b-d95bb690ab7d

	measure 'WAPE Eligible' = VAR f = CALCULATE ( SUM ( Fact_Forecast[ForecastRevenueVND] ), Fact_Forecast[ScenarioKey] = "BASE", Fact_Forecast[Eligibility] = "true" ) RETURN DIVIDE ( ABS ( f - [Net Revenue] ), ABS ( [Net Revenue] ) )
		formatString: 0.0%
		displayFolder: 06 Forecast
		lineageTag: d67f5bf8-f60f-4910-8778-4bf7b4afe769

