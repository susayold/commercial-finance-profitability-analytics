{
  "model_name": "VNFinance_Commercial_Finance_v2",
  "grain": "monthly operating and transaction facts",
  "source_workbook": "VietNova_FPA_Model_v2.xlsx",
  "evidence_policy": {
    "synthetic_operating_data": true,
    "reported_peer_data": true,
    "blank_unverified_values_allowed": true,
    "approved_peer_dataset": "data/peer_benchmark_approved_2016_2025.csv"
  },
  "dimensions": [
    {
      "name": "Calendar",
      "key": "DateKey",
      "columns": [
        "DateKey",
        "Month",
        "FiscalYear",
        "FiscalQuarter"
      ]
    },
    {
      "name": "Product_Master",
      "key": "ProductID",
      "columns": [
        "ProductID",
        "Category",
        "Brand",
        "PackSize",
        "StandardCost"
      ]
    },
    {
      "name": "Customer_Master",
      "key": "CustomerID",
      "columns": [
        "CustomerID",
        "CustomerName",
        "ChannelID",
        "Region",
        "PaymentTermsDays"
      ]
    },
    {
      "name": "Channel_Master",
      "key": "ChannelID",
      "columns": [
        "ChannelID",
        "ChannelName",
        "FeeRate",
        "CMHurdle"
      ]
    },
    {
      "name": "Scenario Selector",
      "key": "Scenario",
      "columns": [
        "Scenario"
      ],
      "disconnected": true
    }
  ],
  "facts": [
    {
      "name": "Sales_Fact",
      "grain": "invoice line",
      "keys": [
        "DateKey",
        "ProductID",
        "CustomerID",
        "ChannelID"
      ],
      "measures": [
        "Gross_Sales_VND",
        "Discount_VND",
        "Returns_VND",
        "Net_Revenue_VND",
        "COGS_VND",
        "Units"
      ]
    },
    {
      "name": "Commercial_Costs",
      "grain": "cost event x month x channel",
      "keys": [
        "DateKey",
        "ChannelID"
      ],
      "measures": [
        "Trade_Spend_VND",
        "Platform_Fee_VND",
        "Freight_VND",
        "Variable_Cost_VND"
      ]
    },
    {
      "name": "Inventory",
      "grain": "SKU x month",
      "keys": [
        "DateKey",
        "ProductID"
      ],
      "measures": [
        "Inventory_Value_VND",
        "Units_On_Hand"
      ]
    },
    {
      "name": "AR",
      "grain": "customer x month",
      "keys": [
        "DateKey",
        "CustomerID"
      ],
      "measures": [
        "Ending_AR_VND",
        "Overdue_AR_VND"
      ]
    },
    {
      "name": "AP",
      "grain": "supplier x month",
      "keys": [
        "DateKey"
      ],
      "measures": [
        "Ending_AP_VND"
      ]
    },
    {
      "name": "Budget",
      "grain": "month x channel x scenario",
      "keys": [
        "DateKey",
        "ChannelID",
        "Scenario"
      ],
      "measures": [
        "Budget_Revenue_VND",
        "Budget_Gross_Profit_VND",
        "Budget_Opex_VND"
      ]
    },
    {
      "name": "Forecast_Versions",
      "grain": "month x channel x scenario",
      "keys": [
        "DateKey",
        "ChannelID",
        "Scenario"
      ],
      "measures": [
        "Forecast_Revenue_VND",
        "Forecast_CM_VND",
        "Confidence_Low",
        "Confidence_High"
      ]
    },
    {
      "name": "Peer_Benchmark",
      "grain": "company x fiscal_year",
      "keys": [
        "Ticker",
        "FiscalYear"
      ],
      "measures": [
        "Net_Revenue_VND_bn",
        "Gross_Profit_VND_bn",
        "Operating_Profit_VND_bn",
        "Profit_Before_Tax_VND_bn",
        "Profit_After_Tax_VND_bn",
        "Total_Assets_VND_bn",
        "Owners_Equity_VND_bn",
        "Operating_Cash_Flow_VND_bn",
        "PBT_Margin",
        "PAT_Margin",
        "Revenue_to_Assets"
      ],
      "filters": [
        "Source_Status = reported_summary_verified or reported_statement_verified",
        "Use Peer_Benchmark_Approved_2016_2025.csv; never include review-required rows"
      ],
      "attributes": [
        "Company",
        "Source_Status",
        "Source_Layer",
        "Revenue_Basis",
        "Page_Anchor",
        "Comparability_Note",
        "Source_URL"
      ]
    },
    {
      "name": "Peer_Review_Queue",
      "grain": "candidate row x fiscal_year",
      "keys": [
        "Ticker",
        "FiscalYear"
      ],
      "measures": [
        "Review_Status",
        "Required_Metrics",
        "Source_Document"
      ],
      "attributes": [
        "Company",
        "Source_Layer",
        "Required_Metrics"
      ]
    },
    {
      "name": "OPEX_Headcount",
      "grain": "cost center x month",
      "keys": [
        "period",
        "cost_center"
      ],
      "measures": [
        "headcount_open",
        "hires",
        "exits",
        "headcount_close",
        "avg_headcount",
        "avg_salary_vnd",
        "payroll_vnd",
        "benefits_vnd",
        "bonus_vnd",
        "non_payroll_opex_vnd",
        "opex_actual_vnd",
        "opex_budget_vnd",
        "opex_forecast_vnd",
        "budget_variance_vnd",
        "forecast_variance_vnd"
      ],
      "attributes": [
        "function",
        "evidence_class",
        "source_system"
      ]
    },
    {
      "name": "CAPEX_Projects",
      "grain": "project x month",
      "keys": [
        "period",
        "project_id"
      ],
      "measures": [
        "budget_capex_vnd",
        "actual_capex_vnd",
        "forecast_capex_vnd",
        "committed_capex_vnd",
        "asset_cost_vnd",
        "depreciation_vnd",
        "expected_annual_contribution_vnd",
        "payback_months",
        "cash_payment_vnd",
        "budget_variance_vnd",
        "forecast_variance_vnd"
      ],
      "attributes": [
        "cost_center",
        "capex_type",
        "approval_status",
        "in_service_period",
        "useful_life_months",
        "evidence_class",
        "source_system"
      ]
    }
  ],
  "relationships": [
    [
      "Calendar[DateKey]",
      "Sales_Fact[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "Commercial_Costs[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "Inventory[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "AR[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "AP[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "Budget[DateKey]"
    ],
    [
      "Calendar[DateKey]",
      "Forecast_Versions[DateKey]"
    ],
    [
      "Product_Master[ProductID]",
      "Sales_Fact[ProductID]"
    ],
    [
      "Product_Master[ProductID]",
      "Inventory[ProductID]"
    ],
    [
      "Customer_Master[CustomerID]",
      "Sales_Fact[CustomerID]"
    ],
    [
      "Customer_Master[CustomerID]",
      "AR[CustomerID]"
    ],
    [
      "Channel_Master[ChannelID]",
      "Sales_Fact[ChannelID]"
    ],
    [
      "Channel_Master[ChannelID]",
      "Commercial_Costs[ChannelID]"
    ],
    [
      "Channel_Master[ChannelID]",
      "Budget[ChannelID]"
    ],
    [
      "Channel_Master[ChannelID]",
      "Forecast_Versions[ChannelID]"
    ],
    [
      "Calendar[YearMonth]",
      "OPEX_Headcount[period]"
    ],
    [
      "Calendar[YearMonth]",
      "CAPEX_Projects[period]"
    ]
  ],
  "pages": [
    {
      "name": "Executive Output",
      "question": "What decision should the CFO make this month?",
      "visuals": [
        "scenario selector",
        "revenue",
        "EBITDA proxy",
        "contribution margin",
        "CCC",
        "risk flag",
        "action table",
        "OPEX variance",
        "CAPEX payback"
      ]
    },
    {
      "name": "P&L and Variance",
      "question": "Why did actuals miss or beat plan?",
      "visuals": [
        "actual vs budget vs forecast",
        "variance waterfall",
        "top drivers",
        "OPEX/headcount bridge"
      ]
    },
    {
      "name": "PVM Bridge",
      "question": "Was growth price, volume, mix or spend?",
      "visuals": [
        "price-volume-mix bridge",
        "monthly bridge",
        "driver table"
      ]
    },
    {
      "name": "Channel and Customer Profitability",
      "question": "Which growth pays back after cost-to-serve?",
      "visuals": [
        "channel CM",
        "customer drillthrough",
        "SKU matrix",
        "25% hurdle"
      ]
    },
    {
      "name": "Working Capital and Liquidity",
      "question": "Where is cash trapped and what releases it?",
      "visuals": [
        "DSO/DIO/DPO/CCC",
        "AR ageing",
        "inventory cover",
        "liquidity stress",
        "CAPEX cash timing"
      ]
    },
    {
      "name": "Controls and Evidence",
      "question": "Can a reviewer trust the number?",
      "visuals": [
        "tie-outs",
        "row counts",
        "formula status",
        "source/evidence legend",
        "review queue"
      ]
    }
  ],
  "acceptance_tests": [
    "Net Revenue ties to Sales_Fact and Excel PnL within VND 100m deterministic rounding tolerance",
    "Channel contribution sums to total contribution",
    "Checks[MODEL STATUS] equals PASS",
    "No negative sales facts",
    "Every visual shows evidence classification and refresh timestamp",
    "Unapproved peer candidates are excluded from benchmark trend visuals and clearly flagged in Controls & Evidence",
    "OPEX actual, budget and forecast reconcile by cost center with headcount bridge",
    "CAPEX actual, commitment, depreciation and payback reconcile by project"
  ]
}
